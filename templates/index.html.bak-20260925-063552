<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TerraVeil — Industrial Mine Subsidence & Geospatial Monitoring Console</title>
    
    <!-- Inter & JetBrains Mono Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Leaflet GIS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Application CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/digital-twin.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/insar.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/insar-zones.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/node-placement.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/node-orientation.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/stage3-demo.css') }}">
    <script type="importmap">{"imports":{"three":"/static/vendor/three/three.module.js","three/addons/":"/static/vendor/three/addons/"}}</script>
</head>
<body>

<div class="app-container">
    
    <!-- ==================================================
         LEFT SIDEBAR
         =================================================== -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor"/>
                    <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="brand-text">
                <h2>TerraVeil</h2>
                <span>Geospatial Safety Platform</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <span class="nav-section-title">MONITORING</span>
                <a href="#" class="nav-link active" data-target="view-live">
                    <span class="nav-icon">⌖</span>
                    <span>Live Monitoring</span>
                </a>
                <a href="#" class="nav-link" data-target="view-history">
                    <span class="nav-icon">◷</span>
                    <span>Historical Analysis</span>
                </a>
                <a href="?view=twin" class="nav-link" data-target="view-twin">
                    <span class="nav-icon">⬡</span>
                    <span>Digital Twin</span>
                </a>
                <a href="?view=insar" class="nav-link" data-target="view-insar">
                    <span class="nav-icon">▱</span>
                    <span>InSAR 3D Map</span>
                </a>
                <a href="#" class="nav-link" data-target="view-network">
                    <span class="nav-icon">⌁</span>
                    <span>Sensor Network</span>
                </a>
                <a href="#" class="nav-link" data-target="view-placement" id="nav-link-placement">
                    <span class="nav-icon">🎯</span>
                    <span>Node Placement</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">SAFETY</span>
                <a href="#" class="nav-link" data-target="view-alerts">
                    <span class="nav-icon">⚠</span>
                    <span>Risk & Alerts</span>
                    <span class="badge badge-danger" id="sidebar-alert-badge">0</span>
                </a>
                <a href="#" class="nav-link" data-target="view-zones">
                    <span class="nav-icon">⚃</span>
                    <span>Risk Zones</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">ANALYTICS</span>
                <a href="#" class="nav-link" data-target="view-ai">
                    <span class="nav-icon">◈</span>
                    <span>AI Analysis</span>
                </a>
                <a href="#" class="nav-link" data-target="view-reports">
                    <span class="nav-icon">▤</span>
                    <span>Reports</span>
                </a>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">SYSTEM</span>
                <a href="#" class="nav-link" data-target="view-health">
                    <span class="nav-icon">⚙</span>
                    <span>System Health</span>
                </a>
                <a href="#" class="nav-link" data-target="view-settings">
                    <span class="nav-icon">⚙</span>
                    <span>Settings</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="status-indicator">
                <span class="status-dot dot-online"></span>
                <div>
                    <strong>● LOCAL MODE</strong>
                    <span id="sidebar-mode-status">Connecting</span>
                </div>
            </div>
            <span class="sys-version"><span class="data-source-label">CONNECTING</span></span>
        </div>
    </aside>

    <!-- ==================================================
         MAIN CONTENT WORKSPACE
         =================================================== -->
    <main class="main-workspace">
        
        <!-- TOP HEADER -->
        <header class="top-header">
            <div class="header-left">
                <div class="site-selector">
                    <span class="selector-label">ACTIVE SITE</span>
                    <select id="mine-select" class="custom-select">
                        <option value="chasnalla" selected>Chasnalla Colliery — Panel East</option>
                        <option value="jharia">Jharia Coalfield (Jharkhand, IN)</option>
                    </select>
                </div>
            </div>
            <div class="header-right">
                <div class="emergency-alert-trigger-wrapper">
                    <button class="btn-emergency-alert" id="btn-trigger-alert" title="Emergency Command: Activate All Mine Sirens & Trigger Red Alert">
                        <span class="alert-icon-pulse">🚨</span>
                        <span class="alert-btn-text">ALERT</span>
                    </button>
                </div>
                <div class="connection-status">
                    <span class="status-pill offline-first" id="header-status-pill">
                        ● LOCAL MODE (SQLite + ML)
                    </span>
                    <span class="status-pill sim-badge">
                        <span class="data-source-label">CONNECTING</span>
                    </span>
                </div>
                <div class="sync-status">
                    <span>Sync: <strong id="header-sync-time">--</strong></span>
                </div>
                <div class="notifications-bell">
                    <button class="header-btn" id="bell-btn" title="System Alerts">
                        🔔
                        <span class="bell-badge badge-danger" id="bell-badge" style="display:none;">0</span>
                    </button>
                </div>
                <!-- Theme Toggle Button -->
                <div class="theme-toggle-wrapper">
                    <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Switch to Light Mode" aria-label="Switch to Light Mode">
                        <span class="theme-icon sun-icon">☀️</span>
                        <span class="theme-icon moon-icon">🌙</span>
                        <span class="theme-label" id="theme-toggle-label">Dark Mode</span>
                    </button>
                </div>
                <div class="user-profile">
                    <div class="avatar">OP</div>
                    <span class="username">Operator Console</span>
                </div>
            </div>
        </header>

        <!-- KPI STRIP -->
        <div class="stage3-demo-bar">
            <div class="stage3-mode-control">
                <label>
                    Data source
                    <select id="hardware-mode">
                        <option value="REAL">REAL HARDWARE</option>
                        <option value="SIMULATION">SIMULATION</option>
                    </select>
                </label>
            </div>

            <button type="button" id="btn-stage3-zero"
                    class="stage3-control-btn zero">
                SET ZERO / ARM DEMO
            </button>

            <button type="button" id="btn-stage3-geophone"
                    class="stage3-control-btn seismic" disabled>
                SIMULATE GEOPHONE PRECURSOR
            </button>

            <div id="stage3-baseline-status"
                 class="stage3-baseline-status" role="status">
                Demo engine: waiting for REAL hardware
            </div>

            <div id="hardware-health"
                 class="stage3-hardware-health" role="status">
                Connecting to Mother Host…
            </div>
        </div>
        <!-- =========================================================
            REAL HARDWARE CONNECTIVITY STRIP
            Only shown when REAL HARDWARE mode is active
        ========================================================== -->
        <div id="real-hardware-strip"
            style="
                display:none;
                grid-template-columns:repeat(4, 1fr);
                gap:8px;
                padding:8px 16px;
            ">

            <div id="conn-host"
                style="
                    border:1px solid var(--border-subtle);
                    border-radius:6px;
                    padding:10px;
                    background:var(--bg-input);
                ">
                HOST-01
            </div>

            <div id="conn-ug01"
                style="
                    border:1px solid var(--border-subtle);
                    border-radius:6px;
                    padding:10px;
                    background:var(--bg-input);
                ">
                UG-01
            </div>

            <div id="conn-ug02"
                style="
                    border:1px solid var(--border-subtle);
                    border-radius:6px;
                    padding:10px;
                    background:var(--bg-input);
                ">
                UG-02
            </div>

            <div id="conn-ld01"
                style="
                    border:1px solid var(--border-subtle);
                    border-radius:6px;
                    padding:10px;
                    background:var(--bg-input);
                ">
                LD-01
            </div>

        </div>
        <section class="kpi-strip">
            <div class="kpi-card">
                <span class="kpi-label">ACTIVE NODES</span>
                <div class="kpi-body">
                    <span class="kpi-value" id="kpi-active-nodes">—</span>
                    <span class="kpi-status status-green" id="kpi-active-status">UNCONFIRMED</span>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">HIGH-RISK ZONES</span>
                <div class="kpi-body">
                    <span class="kpi-value" id="kpi-risk-zones">—</span>
                    <span class="kpi-status status-red" id="kpi-risk-zones-status">Immediate attention</span>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">ACTIVE ANOMALIES</span>
                <div class="kpi-body">
                    <span class="kpi-value" id="kpi-anomalies">—</span>
                    <span class="kpi-status status-amber" id="kpi-anomalies-status">ML triggers active</span>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">SYSTEM HEALTH</span>
                <div class="kpi-body">
                    <span class="kpi-value" id="kpi-system-health">UNCONFIRMED</span>
                    <span class="kpi-status status-green">Host status</span>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">LAST SYNC</span>
                <div class="kpi-body">
                    <span class="kpi-value" id="kpi-sync-sec">1.2s</span>
                    <span class="kpi-status status-green">Polling / Sync</span>
                </div>
            </div>
        </section>

        <!-- WORKSPACE CONTENT AREA -->
        <div class="workspace-content">

            <!-- ==========================================
                 TAB 1: LIVE MONITORING
                 ========================================== -->
            <div id="view-live" class="tab-view active">
                <div class="live-layout">
                    <!-- Left: Hero Map -->
                    <div class="map-container-wrapper">
                        <div class="panel-header">
                            <div class="panel-title-group">
                                <span class="panel-eyebrow">GEOSPATIAL INTELLIGENCE</span>
                                <h3>Mine Surface Network & Deformation Zones</h3>
                            </div>
                            <div class="map-controls-group">
                                <span class="live-tag" id="map-live-tag">● LIVE</span>
                                <div class="map-btn-group">
                                    <button type="button" class="map-control-chip active" id="btn-toggle-insar-layer" title="Toggle 27 Jharia InSAR Subsidence Hotspot Footprints">
                                        <span class="chip-dot"></span> InSAR Zones (27)
                                    </button>
                                    <button type="button" class="map-control-chip" id="btn-toggle-insar-table" title="Toggle InSAR Subsidence Zones Data Table">
                                        <span class="chip-icon">📊</span> Table
                                    </button>
                                    <button type="button" class="map-control-chip" id="btn-fit-jharia" title="Fit map view to Jharia InSAR Subsidence Footprints">
                                        <span class="chip-icon">⛶</span> Jharia Extent
                                    </button>
                                    <button type="button" class="map-control-chip" id="btn-toggle-placement-panel" title="Node Placement Recommendation Engine">
                                        <span class="chip-icon">🎯</span> Placement AI
                                    </button>
                                    <button type="button" class="map-control-chip active" id="btn-toggle-placement-layer" title="Toggle Recommended Node Locations Layer">
                                        <span class="chip-icon">◈</span> Anchors (<span id="placement-count-badge">0</span>)
                                    </button>
                                </div>
                                <div class="map-legend">
                                    <span class="legend-item"><span class="legend-dot bg-green"></span>Normal</span>
                                    <span class="legend-item"><span class="legend-dot bg-amber"></span>Warning</span>
                                    <span class="legend-item"><span class="legend-dot bg-red"></span>Critical</span>
                                </div>
                            </div>
                        </div>
                        <div id="map"></div>
                        <div id="insar-zones-drawer" class="insar-zones-drawer collapsed"></div>
                        <div id="node-placement-panel" class="node-placement-drawer collapsed"></div>
                    </div>

                    <!-- Right: Selected Node Sidebar -->
                    <aside class="selected-node-sidebar">
                        <div class="panel-header">
                            <span class="panel-eyebrow">NODE TELEMETRY</span>
                            <h3 id="sidebar-node-title">No Node Selected</h3>
                        </div>
                        
                        <div id="node-info-content">
                            <div class="empty-node-state">
                                <div class="empty-icon">⌖</div>
                                <p>Select an underground or crack node on the GIS map to inspect telemetry, ML contribution, and safety procedures.</p>
                            </div>
                        </div>
                    </aside>
                </div>

                <!-- Live Monitoring Lower Grid -->
                <div class="lower-layout-grid">
                    <!-- Deformation Trend Chart -->
                    <div class="chart-panel card">
                        <div class="panel-header flex-header">
                            <div class="panel-title-group">
                                <span class="panel-eyebrow">TIME-SERIES TELEMETRY</span>
                                <h3>Deformation & Sensor Trends</h3>
                            </div>
                            <div class="chart-filters">
                                <select id="chart-metric-select" class="custom-select-small">
                                    <option value="risk_score">Risk Score</option>
                                    <option value="tilt">Tilt Vector Magnitude</option>
                                    <option value="vibration">Vibration</option>
                                    <option value="displacement">Displacement (mm)</option>
                                </select>
                                <div class="time-range-group">
                                    <button class="range-btn active" data-range="1h">1H</button>
                                    <button class="range-btn" data-range="6h">6H</button>
                                    <button class="range-btn" data-range="24h">24H</button>
                                    <button class="range-btn" data-range="7d">7D</button>
                                </div>
                            </div>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="liveTrendChart"></canvas>
                        </div>
                    </div>

                    <!-- Risk Zones Summary -->
                    <div class="risk-zones-panel card">
                        <div class="panel-header">
                            <span class="panel-eyebrow">SPATIAL CORRELATION</span>
                            <h3>Active Deformation Risk Zones</h3>
                        </div>
                        <div class="risk-zones-list" id="active-zones-list">
                            <div class="empty-list-state">No spatial anomalies detected. Network shows normal background noise.</div>
                        </div>
                    </div>

                    <!-- Recent Alerts Panel -->
                    <div class="alerts-panel card">
                        <div class="panel-header">
                            <span class="panel-eyebrow">EVENT LOGGER</span>
                            <h3>Recent System Anomalies</h3>
                        </div>
                        <div class="alerts-list" id="recent-alerts-container">
                            <div class="empty-list-state">No active safety warnings.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TAB 2: HISTORICAL ANALYSIS
                 ========================================== -->
            {% include 'digital_twin.html' %}
            {% include 'insar.html' %}
            {% include 'node_placement.html' %}
            <div id="view-history" class="tab-view hidden">
                <div class="history-page card">
                    <div class="panel-header">
                        <span class="panel-eyebrow">CHRONOLOGICAL RETRIEVAL</span>
                        <h3>Historical Subsidence Queries</h3>
                    </div>
                    <form class="history-query-form" id="history-form">
                        <div class="form-group">
                            <label>Primary Node</label>
                            <select id="hist-primary-node" class="custom-select">
                                <!-- Populated dynamically -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Compare With</label>
                            <select id="hist-compare-node" class="custom-select">
                                <option value="none">-- None --</option>
                                <!-- Populated dynamically -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Metric</label>
                            <select id="hist-metric" class="custom-select">
                                <option value="risk_score">Risk Score</option>
                                <option value="tilt">Tilt Vector</option>
                                <option value="vibration">Vibration</option>
                                <option value="displacement">Displacement (mm)</option>
                                <option value="battery">Battery Life</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Timeframe</label>
                            <select id="hist-timeframe" class="custom-select">
                                <option value="1h">Last Hour</option>
                                <option value="6h">Last 6 Hours</option>
                                <option value="24h" selected>Last 24 Hours</option>
                                <option value="7d">Last 7 Days</option>
                            </select>
                        </div>
                        <div class="form-group button-group">
                            <button type="button" class="btn btn-primary" id="btn-run-query">Run Historical Query</button>
                        </div>
                    </form>

                    <div class="query-results-wrapper hidden" id="history-results">
                        <div class="historical-chart-container">
                            <canvas id="historicalChart"></canvas>
                        </div>
                        <div class="results-controls">
                            <button class="btn btn-secondary" type="button" id="export-csv">Export Raw Readings (CSV)</button>
                            <button class="btn btn-secondary" type="button" id="export-pdf">Generate PDF Engineering Report</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TAB 3: SENSOR NETWORK
                 ========================================== -->
            <div id="view-network" class="tab-view hidden">
                <div class="network-page card">
                    <div class="panel-header flex-header">
                        <div class="panel-title-group">
                            <span class="panel-eyebrow">NODE ADMINISTRATION</span>
                            <h3>Distributed Sensor Node Registry</h3>
                        </div>
                        <div class="table-filters">
                            <button class="filter-chip active" data-filter="all">All Sensors</button>
                            <button class="filter-chip" data-filter="ground">Underground</button>
                            <button class="filter-chip" data-filter="crack">Crack / Displacement</button>
                            <button class="filter-chip" data-filter="high">Critical</button>
                        </div>
                    </div>
                    <div class="table-wrapper">
                        <table class="industrial-table" id="sensor-registry-table">
                            <thead>
                                <tr>
                                    <th>NODE ID</th>
                                    <th>TYPE</th>
                                    <th>STATUS</th>
                                    <th>RISK</th>
                                    <th>BATTERY</th>
                                    <th>LAST UPDATE</th>
                                    <th>LINK</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TAB 4: RISK & ALERTS
                 ========================================== -->
            <div id="view-alerts" class="tab-view hidden">
                <div class="alerts-page card">
                    <div class="panel-header">
                        <span class="panel-eyebrow">SAFETY LOGS</span>
                        <h3>System Anomalies & Risk Triggers</h3>
                    </div>
                    <div class="alerts-table-wrapper">
                        <table class="industrial-table" id="safety-logs-table">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Source Node</th>
                                    <th>Type</th>
                                    <th>Event Timestamp</th>
                                    <th>Trigger Level</th>
                                    <th>Contributing Flags</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="safety-logs-tbody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TAB 5: RISK ZONES
                 ========================================== -->
            <div id="view-zones" class="tab-view hidden">
                <div class="zones-page card">
                    <div class="panel-header">
                        <span class="panel-eyebrow">CORRELATION MAP</span>
                        <h3>Subsidence Contour Risk Zones</h3>
                    </div>
                    <div class="zones-dashboard-grid" id="zones-details-grid">
                        <!-- Loaded dynamically based on node spatial cluster logic -->
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 TAB 6: AI ANALYSIS (TWO-TIER ARCHITECTURE)
                 ========================================== -->
            <div id="view-ai" class="tab-view hidden">
                <div class="ai-page card">
                    <div class="panel-header">
                        <div class="panel-title-group">
                            <span class="panel-eyebrow">TWO-TIER INTELLIGENCE ARCHITECTURE</span>
                            <h3>Dual-Layer AI: Local Offline ML (Safety Critical) &amp; Asynchronous Historical LLM Intelligence</h3>
                        </div>
                    </div>

                    <!-- Safety Governance Callout Banner -->
                    <div class="ai-safety-banner">
                        <div class="safety-banner-icon">🛡️</div>
                        <div class="safety-banner-text">
                            <strong>SAFETY ARCHITECTURE INVARIANT:</strong>
                            <span>Real-time anomaly detection, risk classification, and emergency siren activations are executed <strong>100% locally and deterministically</strong> by the Offline Edge ML Engine without Internet dependency. The AI/LLM layer operates strictly outside the critical real-time safety path to provide long-term trend analysis, risk progression modeling, and operator-friendly engineering reports.</span>
                        </div>
                    </div>

                    <!-- Two-Tier Comparison Grid -->
                    <div class="ai-tiers-grid">
                        <!-- TIER 1 -->
                        <div class="tier-card tier-realtime">
                            <div class="tier-badge-row">
                                <span class="tier-pill tier-pill-green">● TIER 1: REAL-TIME SAFETY PATH (OFFLINE)</span>
                                <span class="tier-latency">&lt; 1.5 ms Latency</span>
                            </div>
                            <h4>Local Edge ML Anomaly Engine</h4>
                            <p>Processes incoming live telemetry streams directly on gateway hardware. Performs continuous multi-variate anomaly detection, spatial clustering, and immediate hazard alerts without cloud reliance.</p>
                            
                            <div class="tier-spec-list">
                                <div class="spec-row">
                                    <span>Core Algorithm:</span>
                                    <strong>Isolation Forest (Scikit-Learn)</strong>
                                </div>
                                <div class="spec-row">
                                    <span>Execution Locality:</span>
                                    <strong>Edge Gateway / Local SQLite Core</strong>
                                </div>
                                <div class="spec-row">
                                    <span>Internet Required:</span>
                                    <strong class="text-green">No (100% Offline Survivable)</strong>
                                </div>
                                <div class="spec-row">
                                    <span>Critical Safety Path:</span>
                                    <strong class="text-green">YES — Sole Emergency Decision-Maker</strong>
                                </div>
                            </div>
                        </div>

                        <!-- TIER 2 -->
                        <div class="tier-card tier-strategic">
                            <div class="tier-badge-row">
                                <span class="tier-pill tier-pill-blue">◈ TIER 2: ASYNCHRONOUS HISTORICAL LAYER</span>
                                <span class="tier-latency">Asynchronous Advisory</span>
                            </div>
                            <h4>Strategic AI / LLM Intelligence Layer</h4>
